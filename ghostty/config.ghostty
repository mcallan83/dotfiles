font-family = Fira Code
font-family = Menlo
font-size = 18
font-feature = -calt
font-feature = -liga
font-style-italic = false
font-style-bold-italic = false
adjust-cell-height = 50%
background = #2d2d2d
foreground = #cccccc
cursor-color = #cccccc
cursor-text = #2d2d2d
selection-background = #515151
selection-foreground = #cccccc
bold-color = #cccccc
palette = 0=#000000
palette = 1=#f2777a
palette = 2=#99cc99
palette = 3=#ffcc66
palette = 4=#6699cc
palette = 5=#cc99cc
palette = 6=#66cccc
palette = 7=#ffffff
palette = 8=#000000
palette = 9=#f2777a
palette = 10=#99cc99
palette = 11=#ffcc66
palette = 12=#6699cc
palette = 13=#cc99cc
palette = 14=#66cccc
palette = 15=#ffffff
background-opacity = 1
background-blur = false
cursor-style = underline
cursor-style-blink = true
minimum-contrast = 1
window-width = 80
window-height = 25
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = false
quit-after-last-window-closed = false
confirm-close-surface = true
copy-on-select = clipboard
unfocused-split-opacity = 0.9
macos-option-as-alt = false
vt-window-resize-allowed = false
term = xterm-256color
scrollback-limit-bytes = unlimited
scrollback-limit-lines = unlimited
bell-features = system,attention,title,no-border

