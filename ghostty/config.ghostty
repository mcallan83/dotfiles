theme = light:Ayu Light,dark:Ayu Mirage
theme = light:iTerm2 Solarized Light,dark:iTerm2 Solarized Dark
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

adjust-cell-height = 50%
bell-features = system,attention,title,no-border
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard
cursor-style = block
cursor-style-blink = true
font-family = Fira Code
font-family = Menlo
font-size = 18
keybind = super+1=goto_tab:1
keybind = super+9=last_tab
keybind = super+alt+left=previous_tab
keybind = super+alt+right=next_tab
macos-option-as-alt = false
scrollback-limit-bytes = unlimited
split-inherit-working-directory = false
tab-inherit-working-directory = false
term = xterm-256color
unfocused-split-opacity = 0.9
window-inherit-working-directory = false
window-padding-x = 10
window-padding-y = 10
working-directory = home
